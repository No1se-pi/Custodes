# Основные настройки. Файл копируется в ~/.local/share/custodes/.env.
CUSTODES_LANG=eng
CUSTODES_BANWORDS=API_KEY,APIKEY,password,PRIVATE_KEY,SECRET_KEY,ACCESS_TOKEN
CUSTODES_EXCLUDE_PATHS=venv/**,.venv/**,node_modules/**
CUSTODES_LOGO=yes
CUSTODES_OUTPUT_VIOLATIONS=yes
CUSTODES_REVEAL_VALUES=no

# Энтропия в битах на символ. Чем ниже порог, тем больше ложных срабатываний.
CUSTODES_ENTROPY_ENABLED=yes
CUSTODES_ENTROPY_THRESHOLD=4.0
CUSTODES_ENTROPY_MIN_LENGTH=20

# Sonar запускается только после успешной проверки секретов.
CUSTODES_SONAR_ENABLED=no
CUSTODES_SONAR_MODE=docker
CUSTODES_SONAR_HOST_URL=http://localhost:9000
CUSTODES_SONAR_PROJECT_KEY=
CUSTODES_SONAR_TOKEN=
CUSTODES_SONAR_BLOCK_ON_FAILURE=yes
CUSTODES_SONAR_QUALITY_GATE_WAIT=yes
CUSTODES_SONAR_QUALITY_GATE_TIMEOUT=300
CUSTODES_SONAR_SCANNER_IMAGE=sonarsource/sonar-scanner-cli:latest
